{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "860px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "navy",
					"name": "Seeblau",
					"color": "#0A3A6B"
				},
				{
					"slug": "navy-deep",
					"name": "Tiefblau",
					"color": "#072A4F"
				},
				{
					"slug": "primary",
					"name": "Vereinsblau",
					"color": "#0058A8"
				},
				{
					"slug": "secondary",
					"name": "Badeblau",
					"color": "#1C86C6"
				},
				{
					"slug": "sky",
					"name": "Wellenblau",
					"color": "#60B0D8"
				},
				{
					"slug": "sun",
					"name": "Sonnengelb",
					"color": "#F8B000"
				},
				{
					"slug": "sand",
					"name": "Sand",
					"color": "#FFF6E2"
				},
				{
					"slug": "water",
					"name": "Wasser",
					"color": "#EEF6FB"
				},
				{
					"slug": "white",
					"name": "Weiß",
					"color": "#FFFFFF"
				},
				{
					"slug": "text",
					"name": "Text",
					"color": "#23384F"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "mulish",
					"name": "Mulish",
					"fontFamily": "\"Mulish\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Mulish",
							"fontWeight": "200 1000",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/mulish-latin-wght-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Mulish",
							"fontWeight": "200 1000",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/mulish-latin-ext-wght-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Klein",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Normal",
					"size": "1.0625rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Groß",
					"size": "1.375rem",
					"fluid": {
						"min": "1.2rem",
						"max": "1.375rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Sehr groß",
					"size": "2rem",
					"fluid": {
						"min": "1.6rem",
						"max": "2rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Riesig",
					"size": "3rem",
					"fluid": {
						"min": "2.1rem",
						"max": "3rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vw",
				"vh"
			]
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				}
			},
			"core/image": {
				"lightbox": {
					"enabled": true,
					"allowEditing": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--mulish)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.7"
		},
		"spacing": {
			"blockGap": "1.4rem",
			"padding": {
				"left": "clamp(1rem, 4vw, 2.5rem)",
				"right": "clamp(1rem, 4vw, 2.5rem)"
			}
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--navy)"
				},
				"typography": {
					"fontWeight": "800",
					"lineHeight": "1.2",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "clamp(2rem, 1.4rem + 2.4vw, 3rem)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "clamp(1.6rem, 1.25rem + 1.4vw, 2.25rem)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.2rem"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "1.05rem"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "0.95rem"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--secondary)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "999px"
				},
				"typography": {
					"fontWeight": "700",
					"fontSize": "0.95rem"
				},
				"spacing": {
					"padding": {
						"top": "0.75em",
						"bottom": "0.75em",
						"left": "1.5em",
						"right": "1.5em"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--navy)",
						"text": "var(--wp--preset--color--white)"
					}
				}
			}
		}
	}
}